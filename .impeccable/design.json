  "narrative": {
    "northStar": "The Lilac Reference Sheet",
    "overview": "Cool white surfaces, dark violet ink and a configurable lilac accent make a quiet working reference. The user selected F / Lilac from `design-options/light-round/exports/r7oIC.png` and `aKB0r.png`. Geist, compact controls and aligned measurements carry the visual identity.\n\nFine borders and pale tinted surfaces organize the work. Brief color feedback accompanies controls and data changes; reduced-motion preferences suppress it. Purple is the default identity, while Settings allows the accent to follow the user's preference.",
    "keyCharacteristics": [
      "Cool white surfaces with a configurable lilac accent.",
      "Locally hosted Geist and tabular numeric alignment.",
      "Flat working regions, fine borders and gently rounded controls.",
      "Compact mobile measurement tables and a disclosed copy preview."
    ],
    "rules": [
      {
        "name": "The Accent Meaning Rule",
        "body": "Use the current accent for actions, selection and emphasized measurements; derive readable text and foreground shades rather than hardcoding purple across components.",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Right-align measurements and use tabular numerals; keep row labels left-aligned.",
        "section": "typography"
      },
      {
        "name": "The Flat Reference Rule",
        "body": "Separate working regions through tonal surfaces and fine borders; reserve the small shadow and dim backdrop for the Settings modal.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain cool white surfaces and derive accent roles from Settings.",
      "Do use semantic table headers, explicit field labels and visible keyboard focus.",
      "Do preserve numeric alignment and compact selected-band tables on mobile.",
      "Do suppress transitions and the data wash when reduced motion is requested.",
      "Do persist only the accent preference, with a usable visit-only fallback."
    ],
    "donts": [
      "Don't restore the superseded warm-paper teal identity as the default.",
      "Don't turn flat working regions into raised cards.",
      "Don't introduce a second display family or replace authored SVGs with text glyphs.",
      "Don't hardcode accent foregrounds that bypass contrast adjustment."
    ]
  }
}
