  "narrative": {
    "northStar": "The Clinical Reference Sheet",
    "overview": "Warm paper, deep ink and teal create a quiet working reference. One locally hosted type family and compact controls keep dense values legible. The visual character supports the approved clinical workflow without promotional ornament.\n\nBorders and pale tonal surfaces organize content. Motion is brief feedback: controls change color, refreshed data receives a short wash, and copy confirmation appears in place. Reduced-motion preferences suppress transitions and animation.",
    "keyCharacteristics": [
      "Warm paper with restrained teal emphasis.",
      "Compact typography and tabular numeric alignment.",
      "Flat surfaces, fine rules and gently rounded controls.",
      "Native form controls with visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Teal Meaning Rule",
        "body": "Use teal for actionable, selected or emphasized content; retain readable text and structural borders without relying on color alone.",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Right-align measurements and use tabular numerals; keep row labels left-aligned.",
        "section": "typography"
      },
      {
        "name": "The Flat Reference Rule",
        "body": "Separate working regions through tonal surfaces and fine borders rather than raised cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the warm paper, deep ink and teal palette.",
      "Do use semantic table headers, explicit form labels and visible keyboard focus.",
      "Do preserve numeric alignment and contained table scrolling on narrow screens.",
      "Do suppress transition and refresh motion when reduced motion is requested."
    ],
    "donts": [
      "Don't replace the flat tonal surfaces with raised, shadowed cards.",
      "Don't introduce a second display family or decorative type treatment.",
      "Don't replace authored SVG icons with text glyphs."
    ]
  }
}
